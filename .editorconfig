# EditorConfig — https://editorconfig.org
# Los editores (JetBrains nativo, VS Code con plugin) respetan esto:
# cualquiera que toque estos archivos usa el mismo estilo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Los espacios finales pueden ser saltos de línea intencionales en Markdown
trim_trailing_whitespace = false
