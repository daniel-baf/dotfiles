// ~/.config/waybar/config.jsonc — gestionado desde ~/dotfiles (Stow)
// Estilo "isla flotante": la ventana de waybar es transparente y cada grupo
// de módulos (izquierda/centro/derecha) es un chip redondeado aparte -- ver
// style.css (".modules-left/center/right").
{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": ["custom/logo", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["custom/media", "clock"],
    "modules-right": [
        "custom/nvidia",
        "cpu",
        "memory",
        "custom/capslock",
        "custom/numlock",
        "pulseaudio",
        "battery",
        "custom/notifications",
        "tray"
    ],

    "custom/logo": {
        "format": "",
        "on-click": "walker",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },

    "custom/media": {
        "exec": "playerctl -a metadata --format '{{status}} {{artist}} - {{title}}' -F 2>/dev/null",
        "format": "{}",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "clock": {
        "format": " {:%H:%M  •  %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 5
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 5
    },

    "custom/nvidia": {
        "exec": "~/.config/waybar/scripts/nvidia.sh",
        "return-type": "json",
        "interval": 5
    },

    "custom/capslock": {
        "exec": "~/.config/waybar/scripts/capslock.sh",
        "return-type": "json",
        "interval": 1
    },

    "custom/numlock": {
        "exec": "~/.config/waybar/scripts/numlock.sh",
        "return-type": "json",
        "interval": 1
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pwvucontrol",
        "scroll-step": 5
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon} {}",
        "format-icons": {
            "notification": "",
            "none": "",
            "dnd-notification": "",
            "dnd-none": ""
        },
        "on-click": "swaync-client -t -sw",
        "escape": true
    },

    "tray": {
        "spacing": 8
    }
}
